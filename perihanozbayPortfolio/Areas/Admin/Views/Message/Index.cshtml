@model IEnumerable<Message>
@{ ViewData["Title"]="Gelen Mesajlar"; }
<h1>Gelen Mesajlar (@ViewBag.Unread okunmamış)</h1>
<form method="get" class="search"><input name="q" value="@ViewBag.Query" placeholder="Gönderen veya konu ara"/><select name="sort"><option value="desc">Yeniden eskiye</option><option value="asc">Eskiden yeniye</option></select><button class="btn">Ara</button></form>
@if(!Model.Any()){<p class="empty">Mesaj bulunamadı.</p>}
else{<div class="table-wrap"><table><thead><tr><th>Gönderen</th><th>Konu</th><th>Tarih</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>
@foreach(var m in Model){<tr><td>@m.FullName</td><td>@m.Subject</td><td>@m.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><span class="@(m.IsRead?"read":"unread")">@(m.IsRead?"Okundu":"Okunmadı")</span></td><td><a class="btn small light" asp-action="Details" asp-route-id="@m.MessageId">Detay</a></td></tr>}</tbody></table></div>}
