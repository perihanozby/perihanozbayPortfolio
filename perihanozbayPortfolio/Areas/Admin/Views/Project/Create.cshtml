@model Project
@{
    ViewData["Title"] = "Projeler - Ekle";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Bilgileri düzenleyip Kaydet butonuna basın.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye Dön</a>
    </div>
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form method="post" class="editor">
                @Html.AntiForgeryToken()
                <div class="text-danger mb-3" asp-validation-summary="All"></div>
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
<label for="field_Title" class="form-label fw-semibold">Başlık</label>
Title<input class="form-control" id="field_Title" name="Title" value="@Model.Title" type="text" />
<span class="text-danger small">@Html.ValidationMessage("Title")</span>
</div>
<div class="col-12">
<label for="field_Description" class="form-label fw-semibold">Açıklama</label>
Description<textarea class="form-control" id="field_Description" name="Description" rows="4">@Model.Description</textarea>
<span class="text-danger small">@Html.ValidationMessage("Description")</span>
</div>
<div class="col-12">
<label for="field_Detail" class="form-label fw-semibold">Detail</label>
Detail<textarea class="form-control" id="field_Detail" name="Detail" rows="4">@Model.Detail</textarea>
<span class="text-danger small">@Html.ValidationMessage("Detail")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_ImageUrl" class="form-label fw-semibold">Görsel URL</label>
ImageUrl<input class="form-control" id="field_ImageUrl" name="ImageUrl" value="@Model.ImageUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("ImageUrl")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_GithubUrl" class="form-label fw-semibold">GitHub URL</label>
GithubUrl<input class="form-control" id="field_GithubUrl" name="GithubUrl" value="@Model.GithubUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("GithubUrl")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_DemoUrl" class="form-label fw-semibold">Demo URL</label>
DemoUrl<input class="form-control" id="field_DemoUrl" name="DemoUrl" value="@Model.DemoUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("DemoUrl")</span>
</div>
<div class="col-12 col-lg-6">
<div class="form-check form-switch"><label class="form-check-label" for="field_IsActive">Aktif</label>
IsActive<input class="form-check-input" type="checkbox" id="field_IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><input type="hidden" name="IsActive" value="false" />
</div>
<span class="text-danger small">@Html.ValidationMessage("IsActive")</span>
</div>
<div class="col-12 col-lg-6">
<div class="form-check form-switch"><label class="form-check-label" for="field_IsFeatured">Öne Çıkar</label>
IsFeatured<input class="form-check-input" type="checkbox" id="field_IsFeatured" name="IsFeatured" value="true" @(Model.IsFeatured ? "checked" : "") /><input type="hidden" name="IsFeatured" value="false" />
</div>
<span class="text-danger small">@Html.ValidationMessage("IsFeatured")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_Status" class="form-label fw-semibold">Status</label>
Status<input class="form-control" id="field_Status" name="Status" value="@Model.Status" type="text" />
<span class="text-danger small">@Html.ValidationMessage("Status")</span>
</div>
<div class="col-12">
<label for="field_Technologies" class="form-label fw-semibold">Technologies</label>
Technologies<textarea class="form-control" id="field_Technologies" name="Technologies" rows="4">@Model.Technologies</textarea>
<span class="text-danger small">@Html.ValidationMessage("Technologies")</span>
</div>
<div class="col-12">
<label for="field_Features" class="form-label fw-semibold">Features</label>
Features<textarea class="form-control" id="field_Features" name="Features" rows="4">@Model.Features</textarea>
<span class="text-danger small">@Html.ValidationMessage("Features")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_DisplayOrder" class="form-label fw-semibold">Görüntüleme Sırası</label>
DisplayOrder<input class="form-control" id="field_DisplayOrder" name="DisplayOrder" value="@Model.DisplayOrder" type="number" />
<span class="text-danger small">@Html.ValidationMessage("DisplayOrder")</span>
</div>
<div class="col-12 col-lg-6">
<div class="form-check form-switch"><label class="form-check-label" for="field_IsWide">Is Wide</label>
IsWide<input class="form-check-input" type="checkbox" id="field_IsWide" name="IsWide" value="true" @(Model.IsWide ? "checked" : "") /><input type="hidden" name="IsWide" value="false" />
</div>
<span class="text-danger small">@Html.ValidationMessage("IsWide")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_CodeFileName" class="form-label fw-semibold">Code File Name</label>
CodeFileName<input class="form-control" id="field_CodeFileName" name="CodeFileName" value="@Model.CodeFileName" type="text" />
<span class="text-danger small">@Html.ValidationMessage("CodeFileName")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_CodeLanguage" class="form-label fw-semibold">Code Language</label>
CodeLanguage<input class="form-control" id="field_CodeLanguage" name="CodeLanguage" value="@Model.CodeLanguage" type="text" />
<span class="text-danger small">@Html.ValidationMessage("CodeLanguage")</span>
</div>
<div class="col-12">
<label for="field_CodeSnippet" class="form-label fw-semibold">Code Snippet</label>
CodeSnippet<textarea class="form-control" id="field_CodeSnippet" name="CodeSnippet" rows="4">@Model.CodeSnippet</textarea>
<span class="text-danger small">@Html.ValidationMessage("CodeSnippet")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_ProjectCategoryId" class="form-label fw-semibold">Proje Kategorisi</label>
ProjectCategoryId<select class="form-select" id="field_ProjectCategoryId" name="ProjectCategoryId" required asp-items="@(ViewBag.Options as Microsoft.AspNetCore.Mvc.Rendering.SelectList)"><option value="">Seçiniz</option></select>
<span class="text-danger small">@Html.ValidationMessage("ProjectCategoryId")</span>
</div>
                </div>
                <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-4 border-top">
                    <a class="btn btn-outline-secondary px-4" asp-action="Index">Vazgeç</a>
                    <button class="btn btn-success px-4" type="submit">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
