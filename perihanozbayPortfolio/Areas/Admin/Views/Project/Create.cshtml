@model perihanozbayPortfolio.Entities.Project
@{
    ViewData["Title"] = "Projeler - Ekle";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Proje bilgilerini ve görselini yönetin.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Project" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <label asp-for="Title" class="form-label fw-semibold">Proje Başlığı</label>
                        <input asp-for="Title" type="text" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="Description" class="form-label fw-semibold">Kısa Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="Detail" class="form-label fw-semibold">Proje Detayı</label>
                        <textarea asp-for="Detail" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Detail" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Görsel URL</label>
                        <input asp-for="ImageUrl" type="text" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        <div class="mt-3">
                            <label for="imageFile" class="form-label fw-semibold">Bilgisayardan Görsel Yükle</label>
                            <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
                            @Html.ValidationMessage("imageFile", null, new { @class = "text-danger small" })
                            <div class="form-text">JPG, PNG veya WebP; en fazla 5 MB. Dosya seçilirse Görsel URL yerine yüklenen dosya kullanılır.</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="GithubUrl" class="form-label fw-semibold">GitHub URL</label>
                        <input asp-for="GithubUrl" type="text" class="form-control" />
                        <span asp-validation-for="GithubUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="DemoUrl" class="form-label fw-semibold">Demo URL</label>
                        <input asp-for="DemoUrl" type="text" class="form-control" />
                        <span asp-validation-for="DemoUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="Status" class="form-label fw-semibold">Proje Durumu</label>
                        <input asp-for="Status" type="text" class="form-control" />
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="Technologies" class="form-label fw-semibold">Teknolojiler</label>
                        <textarea asp-for="Technologies" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Technologies" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="Features" class="form-label fw-semibold">Özellikler</label>
                        <textarea asp-for="Features" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Features" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="DisplayOrder" class="form-label fw-semibold">Görüntüleme Sırası</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="CodeFileName" class="form-label fw-semibold">Kod Dosyası Adı</label>
                        <input asp-for="CodeFileName" type="text" class="form-control" />
                        <span asp-validation-for="CodeFileName" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="CodeLanguage" class="form-label fw-semibold">Kod Dili</label>
                        <input asp-for="CodeLanguage" type="text" class="form-control" />
                        <span asp-validation-for="CodeLanguage" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-12">
                        <label asp-for="CodeSnippet" class="form-label fw-semibold">Kod Örneği</label>
                        <textarea asp-for="CodeSnippet" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="CodeSnippet" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="ProjectCategoryId" class="form-label fw-semibold">Proje Kategorisi</label>
                        <select asp-for="ProjectCategoryId" asp-items="@(ViewBag.Options as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select">
                            <option value="">Kategori seçiniz</option>
                        </select>
                        <span asp-validation-for="ProjectCategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">Aktif</label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsFeatured" class="form-check-label">Öne Çıkar</label>
                        </div>
                        <span asp-validation-for="IsFeatured" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsWide" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsWide" class="form-check-label">Geniş Kart</label>
                        </div>
                        <span asp-validation-for="IsWide" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
                    <button type="submit" class="btn btn-success px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
