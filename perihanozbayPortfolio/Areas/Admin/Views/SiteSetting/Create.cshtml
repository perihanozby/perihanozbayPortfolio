@model SiteSetting
@{
    ViewData["Title"] = "Site Ayarları - Ekle";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Bilgileri düzenleyip Kaydet butonuna basın.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye Dön</a>
    </div>
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form method="post" class="editor">
                @Html.AntiForgeryToken()
                <div class="text-danger mb-3" asp-validation-summary="All"></div>
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
<label for="field_SiteName" class="form-label fw-semibold">Site Name</label>
SiteName<input class="form-control" id="field_SiteName" name="SiteName" value="@Model.SiteName" type="text" />
<span class="text-danger small">@Html.ValidationMessage("SiteName")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_LogoText" class="form-label fw-semibold">Logo Text</label>
LogoText<input class="form-control" id="field_LogoText" name="LogoText" value="@Model.LogoText" type="text" />
<span class="text-danger small">@Html.ValidationMessage("LogoText")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_LogoUrl" class="form-label fw-semibold">Logo Url</label>
LogoUrl<input class="form-control" id="field_LogoUrl" name="LogoUrl" value="@Model.LogoUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("LogoUrl")</span>
</div>
<div class="col-12">
<label for="field_FooterDescription" class="form-label fw-semibold">Footer Description</label>
FooterDescription<textarea class="form-control" id="field_FooterDescription" name="FooterDescription" rows="4">@Model.FooterDescription</textarea>
<span class="text-danger small">@Html.ValidationMessage("FooterDescription")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_CvFileUrl" class="form-label fw-semibold">Cv File Url</label>
CvFileUrl<input class="form-control" id="field_CvFileUrl" name="CvFileUrl" value="@Model.CvFileUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("CvFileUrl")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_CopyrightText" class="form-label fw-semibold">Copyright Text</label>
CopyrightText<input class="form-control" id="field_CopyrightText" name="CopyrightText" value="@Model.CopyrightText" type="text" />
<span class="text-danger small">@Html.ValidationMessage("CopyrightText")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_FooterCredit" class="form-label fw-semibold">Footer Credit</label>
FooterCredit<input class="form-control" id="field_FooterCredit" name="FooterCredit" value="@Model.FooterCredit" type="text" />
<span class="text-danger small">@Html.ValidationMessage("FooterCredit")</span>
</div>
                </div>
                <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-4 border-top">
                    <a class="btn btn-outline-secondary px-4" asp-action="Index">Vazgeç</a>
                    <button class="btn btn-success px-4" type="submit">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
