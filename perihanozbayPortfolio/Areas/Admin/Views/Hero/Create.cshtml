@model Hero
@{
    ViewData["Title"] = "Ana Sayfa - Ekle";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Bilgileri düzenleyip Kaydet butonuna basın.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye Dön</a>
    </div>
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form method="post" class="editor">
                @Html.AntiForgeryToken()
                <div class="text-danger mb-3" asp-validation-summary="All"></div>
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
<label for="field_BadgeText" class="form-label fw-semibold">Üst Etiket</label>
BadgeText<input class="form-control" id="field_BadgeText" name="BadgeText" value="@Model.BadgeText" type="text" />
<span class="text-danger small">@Html.ValidationMessage("BadgeText")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_GreetingText" class="form-label fw-semibold">Karşılama Metni</label>
GreetingText<input class="form-control" id="field_GreetingText" name="GreetingText" value="@Model.GreetingText" type="text" />
<span class="text-danger small">@Html.ValidationMessage("GreetingText")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_HighlightedName" class="form-label fw-semibold">Vurgulanan İsim</label>
HighlightedName<input class="form-control" id="field_HighlightedName" name="HighlightedName" value="@Model.HighlightedName" type="text" />
<span class="text-danger small">@Html.ValidationMessage("HighlightedName")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_Headline" class="form-label fw-semibold">Ana Başlık</label>
Headline<input class="form-control" id="field_Headline" name="Headline" value="@Model.Headline" type="text" />
<span class="text-danger small">@Html.ValidationMessage("Headline")</span>
</div>
<div class="col-12">
<label for="field_Description" class="form-label fw-semibold">Açıklama</label>
Description<textarea class="form-control" id="field_Description" name="Description" rows="4">@Model.Description</textarea>
<span class="text-danger small">@Html.ValidationMessage("Description")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_ImageUrl" class="form-label fw-semibold">Görsel URL</label>
ImageUrl<input class="form-control" id="field_ImageUrl" name="ImageUrl" value="@Model.ImageUrl" type="text" />
<span class="text-danger small">@Html.ValidationMessage("ImageUrl")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_EducationBadge" class="form-label fw-semibold">Eğitim Etiketi</label>
EducationBadge<input class="form-control" id="field_EducationBadge" name="EducationBadge" value="@Model.EducationBadge" type="text" />
<span class="text-danger small">@Html.ValidationMessage("EducationBadge")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_AvailabilityBadge" class="form-label fw-semibold">Müsaitlik Etiketi</label>
AvailabilityBadge<input class="form-control" id="field_AvailabilityBadge" name="AvailabilityBadge" value="@Model.AvailabilityBadge" type="text" />
<span class="text-danger small">@Html.ValidationMessage("AvailabilityBadge")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_Expertise" class="form-label fw-semibold">Uzmanlık</label>
Expertise<input class="form-control" id="field_Expertise" name="Expertise" value="@Model.Expertise" type="text" />
<span class="text-danger small">@Html.ValidationMessage("Expertise")</span>
</div>
<div class="col-12 col-lg-6">
<label for="field_Approach" class="form-label fw-semibold">Yaklaşım</label>
Approach<input class="form-control" id="field_Approach" name="Approach" value="@Model.Approach" type="text" />
<span class="text-danger small">@Html.ValidationMessage("Approach")</span>
</div>
<div class="col-12 col-lg-6">
<div class="form-check form-switch"><label class="form-check-label" for="field_IsActive">Aktif</label>
IsActive<input class="form-check-input" type="checkbox" id="field_IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><input type="hidden" name="IsActive" value="false" />
</div>
<span class="text-danger small">@Html.ValidationMessage("IsActive")</span>
</div>
                </div>
                <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-4 border-top">
                    <a class="btn btn-outline-secondary px-4" asp-action="Index">Vazgeç</a>
                    <button class="btn btn-success px-4" type="submit">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
