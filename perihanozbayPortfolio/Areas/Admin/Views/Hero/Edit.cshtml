
@model Hero

@{
    ViewData["Title"] = "Ana Sayfa - Düzenle";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">Ana Sayfa - Düzenle</h1>
            <p class="text-muted mb-0">
                Portfolyonun ana sayfasında görüntülenen bilgileri buradan güncelleyebilirsin.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-header bg-white border-bottom py-3 px-4">
            <h5 class="mb-0 fw-semibold">
                Ana Sayfa Bilgileri
            </h5>
        </div>

        <div class="card-body p-4">

            <form method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <!-- Badge Text -->
                    <div class="col-md-6">
                        <label asp-for="BadgeText" class="form-label fw-semibold">
                            Üst Etiket
                        </label>

                        <input asp-for="BadgeText"
                               class="form-control"
                               placeholder="Örn: Yazılım Mühendisi" />

                        <span asp-validation-for="BadgeText"
                              class="text-danger small"></span>
                    </div>

                    <!-- Greeting Text -->
                    <div class="col-md-6">
                        <label asp-for="GreetingText" class="form-label fw-semibold">
                            Karşılama Metni
                        </label>

                        <input asp-for="GreetingText"
                               class="form-control"
                               placeholder="Örn: Merhaba, ben" />

                        <span asp-validation-for="GreetingText"
                              class="text-danger small"></span>
                    </div>

                    <!-- Highlighted Name -->
                    <div class="col-md-6">
                        <label asp-for="HighlightedName" class="form-label fw-semibold">
                            Vurgulanan İsim
                        </label>

                        <input asp-for="HighlightedName"
                               class="form-control"
                               placeholder="Örn: Perihan" />

                        <span asp-validation-for="HighlightedName"
                              class="text-danger small"></span>
                    </div>

                    <!-- Headline -->
                    <div class="col-md-6">
                        <label asp-for="Headline" class="form-label fw-semibold">
                            Ana Başlık
                        </label>

                        <input asp-for="Headline"
                               class="form-control"
                               placeholder="Ana sayfa başlığı" />

                        <span asp-validation-for="Headline"
                              class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Tanıtım Açıklaması
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Kendini ve uzmanlık alanlarını tanıt..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">
                            Profil Görseli URL
                        </label>

                        <input asp-for="ImageUrl"
                               class="form-control"
                               placeholder="https://..." />

                        <span asp-validation-for="ImageUrl"
                              class="text-danger small"></span>

                        <div class="form-text">
                            Ana sayfada görüntülenecek profil fotoğrafının bağlantısı.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
                        {
                            <div class="mt-3">
                                <img src="@Model.ImageUrl"
                                     alt="Mevcut profil görseli"
                                     class="rounded-3 border"
                                     style="width:120px;height:120px;object-fit:cover;"
                                     referrerpolicy="no-referrer" />
                            </div>
                        }
                    </div>

                    <!-- Education Badge -->
                    <div class="col-md-6">
                        <label asp-for="EducationBadge" class="form-label fw-semibold">
                            Eğitim Etiketi
                        </label>

                        <input asp-for="EducationBadge"
                               class="form-control"
                               placeholder="Örn: Yazılım Mühendisliği" />

                        <span asp-validation-for="EducationBadge"
                              class="text-danger small"></span>
                    </div>

                    <!-- Availability Badge -->
                    <div class="col-md-6">
                        <label asp-for="AvailabilityBadge" class="form-label fw-semibold">
                            Müsaitlik Etiketi
                        </label>

                        <input asp-for="AvailabilityBadge"
                               class="form-control"
                               placeholder="Örn: Yeni iş fırsatlarına açık" />

                        <span asp-validation-for="AvailabilityBadge"
                              class="text-danger small"></span>
                    </div>

                    <!-- Expertise -->
                    <div class="col-md-6">
                        <label asp-for="Expertise" class="form-label fw-semibold">
                            Uzmanlık Alanı
                        </label>

                        <input asp-for="Expertise"
                               class="form-control"
                               placeholder="Örn: C# · ASP.NET Core" />

                        <span asp-validation-for="Expertise"
                              class="text-danger small"></span>
                    </div>

                    <!-- Approach -->
                    <div class="col-md-6">
                        <label asp-for="Approach" class="form-label fw-semibold">
                            Çalışma Yaklaşımı
                        </label>

                        <input asp-for="Approach"
                               class="form-control"
                               placeholder="Örn: Clean Architecture" />

                        <span asp-validation-for="Approach"
                              class="text-danger small"></span>
                    </div>

                    <!-- IsActive -->
                    <div class="col-12">

                        <div class="form-check form-switch p-3 ps-5 bg-light rounded-3">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-semibold">
                                Ana Sayfa İçeriği Aktif
                            </label>

                            <div class="form-text">
                                Pasif yapıldığında public tarafta gösterilmesi,
                                public sorgularındaki aktiflik kontrolüne bağlıdır.
                            </div>

                        </div>

                        <span asp-validation-for="IsActive"
                              class="text-danger small"></span>

                    </div>

                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-success px-4">
                        Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
