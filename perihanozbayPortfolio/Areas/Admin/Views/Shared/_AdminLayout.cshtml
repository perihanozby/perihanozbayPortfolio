@{
    var title = ViewData["Title"]?.ToString() ?? "Yönetim Paneli";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@title - Portfolio Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/admin/css/admin.css" asp-append-version="true" />
</head>

<body>

    <aside class="sidebar">

        <div class="brand">
            Perihan Özbay
            <small>PORTFOLYO YÖNETİMİ</small>
        </div>

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">
            📊 Dashboard
        </a>

        <a asp-area=""
           asp-controller="Default"
           asp-action="Index"
           target="_blank">
            ↗ Public Portfolyo
        </a>

        <div class="nav-title">İÇERİK YÖNETİMİ</div>

        @foreach (var item in new (string Controller, string Title)[]
        {
            ("Hero", "Ana Sayfa"),
            ("Metric", "İstatistikler"),
            ("About", "Hakkımda"),
            ("SkillCategory", "Yetenek Kategorileri"),
            ("Skill", "Yetenekler"),
            ("SkillTag", "Yetenek Etiketleri"),
            ("ProjectCategory", "Proje Kategorileri"),
            ("Project", "Projeler"),
            ("Experience", "Deneyimler"),
            ("ExperienceHighlight", "Deneyim Maddeleri"),
            ("Education", "Eğitimler"),
            ("EducationHighlight", "Eğitim Etiketleri"),
            ("ContactInfo", "İletişim"),
            ("SiteSetting", "Site Ayarları")
        })
        {
            <a asp-area="Admin"
               asp-controller="@item.Controller"
               asp-action="Index">
                @item.Title
            </a>
        }

        <a asp-area="Admin" asp-controller="Cv" asp-action="Index">📄 CV Yönetimi</a>
<div class="nav-title">MESAJLAR</div>

        <a asp-area="Admin"
           asp-controller="Message"
           asp-action="Index">
            ✉ Gelen Mesajlar
        </a>

    </aside>

    <div class="content">

        <header class="admin-header">
            <strong>@title</strong>
            <span>Perihan Özbay · Yönetim</span>
        </header>

        <main class="admin-main">

            @if (TempData["Success"] is string notice)
            {
                <div class="alert alert-success">
                    @notice
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/js/admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
