@using perihanozbayPortfolio.Entities
@{ ViewData["Title"]="Dashboard";
var messages=(List<Message>)ViewBag.RecentMessages;var projects=(List<Project>)ViewBag.RecentProjects; }
<h1>Portfolyo Yönetimi</h1><p>İçeriklerinizin güncel veritabanı özeti.</p>
<div class="stats">
@foreach(var stat in new (string Name,int Value)[]{("Toplam Proje",ViewBag.ProjectCount),("Aktif Proje",ViewBag.ActiveProjects),("Yetenek",ViewBag.SkillCount),("Deneyim",ViewBag.ExperienceCount),("Eğitim",ViewBag.EducationCount),("Mesaj",ViewBag.MessageCount),("Okunmamış",ViewBag.UnreadCount)}) {<div class="stat"><span>@stat.Name</span><strong>@stat.Value</strong></div>}
</div>
<div class="columns"><section class="panel"><h2>Son 5 Mesaj</h2>@foreach(var m in messages){<p><a asp-area="Admin" asp-controller="Message" asp-action="Details" asp-route-id="@m.MessageId">@m.FullName — @m.Subject</a> <small>@m.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></p>}</section>
<section class="panel"><h2>Son 3 Proje</h2>@foreach(var x in projects){<p><a asp-area="Admin" asp-controller="Project" asp-action="Edit" asp-route-id="@x.ProjectId">@x.Title</a> · @x.ProjectCategory.Name · @(x.IsActive?"Aktif":"Pasif")</p>}</section></div>
<div class="panel"><h2>Hızlı İşlemler</h2><a class="btn" asp-area="Admin" asp-controller="Project" asp-action="Create">Yeni Proje</a> <a class="btn light" asp-area="Admin" asp-controller="Message" asp-action="Index">Mesajlar</a> <a class="btn light" asp-area="" asp-controller="Default" asp-action="Index" target="_blank">Portfolyoyu Aç</a></div>
