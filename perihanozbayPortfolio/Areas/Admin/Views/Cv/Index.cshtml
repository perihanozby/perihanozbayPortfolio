@{
    ViewData["Title"] = "CV Yönetimi";
    var current = ViewBag.CvFileName as string;
}
<div class="container-fluid px-0">
    <h1 class="mb-2">CV Yönetimi</h1>
    <p class="text-muted mb-4">PDF dosyanı yükle. Public portfolyodaki CV İndir bağlantıları otomatik güncellenir.</p>
    <div class="card border-0 shadow-sm rounded-3" style="max-width:760px">
        <div class="card-body p-4">
            @if (TempData["CvError"] is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            @if (!string.IsNullOrWhiteSpace(current))
            {
                <div class="alert alert-success">Yüklü CV mevcut.
                    <a asp-area="" asp-controller="Cv" asp-action="Download" class="alert-link ms-2">CV'yi indir</a>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">Henüz CV yüklenmemiş.</div>
            }
            <form asp-area="Admin" asp-controller="Cv" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label for="pdf" class="form-label fw-semibold">Yeni CV (PDF)</label>
                <input id="pdf" name="pdf" type="file" class="form-control mb-2" accept=".pdf,application/pdf" required />
                <div class="form-text mb-4">Yalnızca PDF, en fazla 5 MB. Yeni yükleme önceki CV'nin yerini alır.</div>
                <button type="submit" class="btn btn-success">PDF Yükle ve Güncelle</button>
            </form>
        </div>
    </div>
</div>
