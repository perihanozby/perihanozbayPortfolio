
@model List<perihanozbayPortfolio.Entities.Experience>

<div class="lg:col-span-6 flex flex-col">

    <div class="flex items-center gap-2 mb-space-md pb-2 border-b border-outline-variant/40">
        <span class="material-symbols-outlined text-primary-container text-[24px]">
            work_history
        </span>

        <h3 class="font-headline-md text-headline-sm text-primary font-semibold">
            İş Süreçleri &amp; Operasyonel Deneyim
        </h3>
    </div>

    <div class="relative pl-6 space-y-space-md before:content-[''] before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-secondary/40">

        @foreach (var experience in Model)
        {
            <div class="relative">

                <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full @(experience.DisplayOrder == 1 ? "bg-secondary-container" : "bg-surface-variant") ring-4 ring-background">
                </span>

                <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">

                    <div class="flex items-center justify-between mb-1">

                        <span class="font-headline-sm text-label-lg font-bold text-primary">
                            @experience.Title
                        </span>

                        @if (!string.IsNullOrWhiteSpace(experience.Badge))
                        {
                            <span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-outline">
                                @experience.Badge
                            </span>
                        }
                        else if (!string.IsNullOrWhiteSpace(experience.Period))
                        {
                            <span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-outline">
                                @experience.Period
                            </span>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(experience.Subtitle))
                    {
                        <p class="font-label-sm text-label-sm text-secondary font-semibold mb-2">
                            @experience.Subtitle
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(experience.Description))
                    {
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed @(experience.Highlights.Any() ? "mb-2" : "")">
                            @experience.Description
                        </p>
                    }

                    @if (experience.Highlights.Any())
                    {
                        <ul class="text-xs text-on-surface-variant space-y-1 list-disc pl-4">

                            @foreach (var highlight in experience.Highlights)
                            {
                                <li>@highlight.Description</li>
                            }

                        </ul>
                    }

                </div>
            </div>
        }

    </div>
</div>
