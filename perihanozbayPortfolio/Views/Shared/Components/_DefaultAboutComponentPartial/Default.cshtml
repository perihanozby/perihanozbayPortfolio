
@model perihanozbayPortfolio.Entities.About

@if (Model != null)
{
    <section class="w-full py-space-xl bg-background" id="hakkimda">
        <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">
            <div class="flex flex-col mb-space-lg">
                <span
                    class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
                    01 / Profil · Mühendislik Yaklaşımı
                </span>

                <h2
                    class="font-headline-lg text-headline-md md:text-headline-lg text-primary tracking-tight mt-1">
                    Hakkımda
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">

                <!-- Narrative Column -->
                <div
                    class="lg:col-span-7 flex flex-col gap-space-md bg-surface-container-lowest p-space-lg rounded-xl shadow-sm">

                    <h3 class="font-headline-sm text-headline-sm text-primary">
                        @Model.ShortDescription
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        var paragraphs = Model.Description.Split(
                            new[] { "\r\n", "\n" },
                            StringSplitOptions.RemoveEmptyEntries
                        );

                        foreach (var paragraph in paragraphs)
                        {
                            <p class="font-body-md text-body-md text-on-surface leading-relaxed">
                                @paragraph
                            </p>
                        }
                    }

                    <div
                        class="p-space-md bg-surface-container-low rounded-lg flex items-start gap-space-sm">

                        <span
                            class="material-symbols-outlined text-secondary text-[24px] mt-0.5">
                            verified
                        </span>

                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            <strong>Mühendislik İlkem:</strong>
                            @Model.EngineeringPrinciple
                        </p>
                    </div>
                </div>

                <!-- Information Matrix & Facts -->
                <div class="lg:col-span-5 flex flex-col gap-space-md">

                    <div
                        class="bg-surface-container p-space-lg rounded-xl shadow-sm flex flex-col gap-space-md">

                        <h4
                            class="font-label-lg text-label-lg uppercase tracking-wider text-primary font-bold">
                            Özet Bilgi Matrisi
                        </h4>

                        <div class="flex flex-col gap-space-sm">

                            <div
                                class="flex items-start justify-between py-2 border-b border-outline-variant/30">

                                <span class="font-label-md text-label-md text-outline">
                                    Eğitim
                                </span>

                                <span
                                    class="font-body-sm text-body-sm text-primary font-semibold text-right">
                                    @Model.Degree
                                </span>
                            </div>

                            <div
                                class="flex items-start justify-between py-2 border-b border-outline-variant/30">

                                <span class="font-label-md text-label-md text-outline">
                                    Üniversite
                                </span>

                                <span
                                    class="font-body-sm text-body-sm text-primary font-semibold text-right">
                                    @Model.University
                                </span>
                            </div>

                            <div
                                class="flex items-start justify-between py-2 border-b border-outline-variant/30">

                                <span class="font-label-md text-label-md text-outline">
                                    Ana Odak
                                </span>

                                <span
                                    class="font-body-sm text-body-sm text-primary font-semibold text-right">
                                    @Model.MainFocus
                                </span>
                            </div>

                            <div
                                class="flex items-start justify-between py-2 border-b border-outline-variant/30">

                                <span class="font-label-md text-label-md text-outline">
                                    Konum
                                </span>

                                <span
                                    class="font-body-sm text-body-sm text-primary font-semibold text-right">
                                    @Model.Location
                                </span>
                            </div>

                            <div class="flex items-start justify-between py-2">

                                <span class="font-label-md text-label-md text-outline">
                                    Diller
                                </span>

                                <span
                                    class="font-body-sm text-body-sm text-primary font-semibold text-right">
                                    @Model.Languages
                                </span>
                            </div>

                        </div>
                    </div>

                    <!-- Academic & Work Ethic Box -->
                    <div
                        class="bg-primary-container text-surface-container-lowest p-space-md rounded-xl shadow-sm flex items-center gap-space-md">

                        <div
                            class="w-12 h-12 rounded-lg bg-surface-container-lowest/15 flex items-center justify-center shrink-0">

                            <span
                                class="material-symbols-outlined text-secondary-fixed text-[26px]">
                                terminal
                            </span>
                        </div>

                        <div class="flex flex-col">

                            <span
                                class="font-headline-sm text-label-lg font-semibold text-surface-container-lowest">
                                @Model.CareerStatusTitle
                            </span>

                            <span
                                class="font-body-sm text-body-sm text-surface-container-high/80">
                                @Model.CareerStatusDescription
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
}
