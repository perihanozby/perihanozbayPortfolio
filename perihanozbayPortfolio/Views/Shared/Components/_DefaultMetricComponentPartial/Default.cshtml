
@model List<perihanozbayPortfolio.Entities.Metric>

<section class="w-full bg-surface-container-low py-space-md shadow-inner">
    <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-md text-center md:text-left">

            @foreach (var item in Model)
            {
                <div class="flex flex-col">
                    <span class="font-display text-headline-lg @item.ColorClass">
                        @item.Value
                    </span>

                    <span class="font-label-md text-label-md text-on-surface-variant">
                        @item.Description
                    </span>
                </div>
            }

        </div>
    </div>
</section>
