
@model perihanozbayPortfolio.Entities.ContactInfo

<section class="w-full py-space-xl bg-background" id="iletisim">
    <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">

            <!-- Left: Editorial Contact Lead -->
            <div class="lg:col-span-5 flex flex-col">
                <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
                    05 / İletişim · Ortak Çalışma
                </span>

                <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary tracking-tight mt-1 mb-space-sm">
                    @(Model?.Title ?? "Birlikte bir şeyler geliştirelim.")
                </h2>

                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-lg">
                    @Model?.Description
                </p>

                <!-- Direct Channels -->
                <div class="flex flex-col gap-space-sm mb-space-lg">

                    @if (!string.IsNullOrWhiteSpace(Model?.Email))
                    {
                        <a class="p-space-sm rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-all flex items-center gap-space-sm group"
                           href="mailto:@Model.Email">
                            <div class="w-10 h-10 rounded-lg bg-surface-container-lowest text-primary flex items-center justify-center shrink-0 shadow-sm group-hover:bg-primary group-hover:text-surface-container-lowest transition-colors">
                                <span class="material-symbols-outlined text-[20px]">
                                    alternate_email
                                </span>
                            </div>

                            <div class="flex flex-col">
                                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">
                                    E-Posta
                                </span>
                                <span class="font-headline-sm text-label-lg text-primary font-semibold">
                                    @Model.Email
                                </span>
                            </div>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model?.LinkedInUrl))
                    {
                        <a class="p-space-sm rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-all flex items-center gap-space-sm group"
                           href="@Model.LinkedInUrl"
                           rel="noopener noreferrer"
                           target="_blank">
                            <div class="w-10 h-10 rounded-lg bg-surface-container-lowest text-primary flex items-center justify-center shrink-0 shadow-sm group-hover:bg-primary group-hover:text-surface-container-lowest transition-colors">
                                <span class="material-symbols-outlined text-[20px]">
                                    badge
                                </span>
                            </div>

                            <div class="flex flex-col">
                                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">
                                    LinkedIn
                                </span>
                                <span class="font-headline-sm text-label-lg text-primary font-semibold break-all">
                                    @Model.LinkedInUrl.Replace("https://", "").Replace("http://", "").TrimEnd('/')
                                </span>
                            </div>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model?.GithubUrl))
                    {
                        <a class="p-space-sm rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-all flex items-center gap-space-sm group"
                           href="@Model.GithubUrl"
                           rel="noopener noreferrer"
                           target="_blank">
                            <div class="w-10 h-10 rounded-lg bg-surface-container-lowest text-primary flex items-center justify-center shrink-0 shadow-sm group-hover:bg-primary group-hover:text-surface-container-lowest transition-colors">
                                <span class="material-symbols-outlined text-[20px]">
                                    code
                                </span>
                            </div>

                            <div class="flex flex-col">
                                <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider">
                                    GitHub
                                </span>
                                <span class="font-headline-sm text-label-lg text-primary font-semibold break-all">
                                    @Model.GithubUrl.Replace("https://", "").Replace("http://", "").TrimEnd('/')
                                </span>
                            </div>
                        </a>
                    }
                </div>

                <!-- Availability Tag -->
                @if (!string.IsNullOrWhiteSpace(Model?.Location)
                    || !string.IsNullOrWhiteSpace(Model?.WorkModel))
                {
                    <div class="p-space-md rounded-xl bg-surface-container-high/60 flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary text-[22px] mt-0.5">
                            location_on
                        </span>

                        <div class="flex flex-col">
                            <span class="font-label-md text-label-md text-primary font-semibold">
                                Lokasyon &amp; Çalışma Modeli
                            </span>

                            <span class="font-body-sm text-body-sm text-on-surface-variant">
                                @Model?.Location
                                @if (!string.IsNullOrWhiteSpace(Model?.WorkModel))
                                {
                                    <text> — @Model.WorkModel</text>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- Right: ASP.NET Core MVC Contact Form -->
            <div class="lg:col-span-7 bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-lg border-t-4 border-tertiary-container">

                <form class="flex flex-col gap-space-md"
                      id="contactForm"
                      method="post"
                      action="@Url.Action("SendMessage", "Contact")">

                    @Html.AntiForgeryToken()

                    <div class="flex flex-col">
                        <h3 class="font-headline-md text-headline-sm md:text-headline-md text-primary font-bold">
                            Mesaj İletin
                        </h3>

                        <p class="font-body-sm text-body-sm text-outline">
                            Formu doldurarak doğrudan iletişime geçebilirsiniz.
                            Mesajınız kaydedilir ve incelenir.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

                        <!-- FullName -->
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                                   for="FullName">
                                <span>Ad Soyad</span>
                                <span class="text-tertiary text-xs font-normal">
                                    * Zorunlu
                                </span>
                            </label>

                            <input class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                                   id="FullName"
                                   name="FullName"
                                   placeholder="Örn. Ahmet Yılmaz"
                                   maxlength="100"
                                   required
                                   type="text" />
                        </div>

                        <!-- Email -->
                        <div class="flex flex-col gap-1.5">
                            <label class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                                   for="Email">
                                <span>E-Posta Adresi</span>
                                <span class="text-tertiary text-xs font-normal">
                                    * Zorunlu
                                </span>
                            </label>

                            <input class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                                   id="Email"
                                   name="Email"
                                   placeholder="ornek@sirket.com"
                                   maxlength="254"
                                   required
                                   type="email" />
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="flex flex-col gap-1.5">
                        <label class="font-label-md text-label-md text-primary font-semibold"
                               for="Subject">
                            Konu Başlığı
                        </label>

                        <select class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                                id="Subject"
                                name="Subject"
                                required>
                            <option value="İş Fırsatı / Pozisyon Teklifi">
                                İş Fırsatı / Pozisyon Teklifi (.NET &amp; Backend)
                            </option>
                            <option value="Proje Geliştirme & Mimari Danışmanlık">
                                Proje Geliştirme &amp; Mimari Danışmanlık
                            </option>
                            <option value="Genel Bilgi & Tanışma">
                                Genel Bilgi &amp; Tanışma
                            </option>
                        </select>
                    </div>

                    <!-- Message -->
                    <div class="flex flex-col gap-1.5">
                        <div class="flex justify-between items-center">
                            <label class="font-label-md text-label-md text-primary font-semibold"
                                   for="Message">
                                Mesajınız
                            </label>

                            <span class="font-label-sm text-label-sm text-outline"
                                  id="charCount">
                                0 / 1000
                            </span>
                        </div>

                        <textarea class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all resize-y"
                                  id="Message"
                                  name="Content"
                                  maxlength="1000"
                                  minlength="10"
                                  placeholder="Projeniz, teklif detayları veya sormak istediğiniz soruları buraya yazabilirsiniz..."
                                  required
                                  rows="5"></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-space-sm pt-2">
                        <button class="w-full sm:w-auto px-space-lg py-3 rounded-lg bg-tertiary-container hover:bg-tertiary text-surface-container-lowest font-label-lg text-label-lg transition-all shadow-md hover:-translate-y-0.5 inline-flex items-center justify-center gap-2 cursor-pointer"
                                id="submitBtn"
                                type="submit">
                            <span>Mesaj Gönder</span>
                            <span class="material-symbols-outlined text-[18px]">
                                send
                            </span>
                        </button>

                        <div class="flex items-center gap-2 text-xs text-outline">
                            <span class="material-symbols-outlined text-[16px] text-secondary">
                                database
                            </span>
                            <span>Mesajınız güvenli bağlantı üzerinden iletilir.</span>
                        </div>
                    </div>

                    <!-- Form Feedback -->
                    <div class="hidden p-space-sm rounded-lg bg-secondary-container text-primary font-body-sm text-body-sm flex items-center gap-2"
                         id="formSuccessAlert"
                         role="status"
                         aria-live="polite">
                        <span class="material-symbols-outlined text-secondary text-[22px]">
                            check_circle
                        </span>
                        <span id="formFeedbackText"></span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const form = document.getElementById("contactForm");
        const messageInput = document.getElementById("Message");
        const charCount = document.getElementById("charCount");
        const submitBtn = document.getElementById("submitBtn");
        const alertBox = document.getElementById("formSuccessAlert");
        const feedbackText = document.getElementById("formFeedbackText");

        if (!form || !messageInput) return;

        function updateCharCount() {
            charCount.textContent = messageInput.value.length + " / 1000";
        }

        messageInput.addEventListener("input", updateCharCount);
        updateCharCount();

        form.addEventListener("submit", async function (event) {
            event.preventDefault();

            if (!form.reportValidity()) return;

            submitBtn.disabled = true;
            alertBox.classList.add("hidden");

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    credentials: "same-origin"
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    const details = Array.isArray(result.errors)
                        ? result.errors.join(" ")
                        : "";

                    throw new Error(
                        details || result.message || "Mesaj gönderilemedi."
                    );
                }

                feedbackText.textContent = result.message;
                alertBox.classList.remove("hidden");

                form.reset();
                updateCharCount();
            }
            catch (error) {
                feedbackText.textContent =
                    error.message || "Bağlantı hatası oluştu.";

                alertBox.classList.remove("hidden");
            }
            finally {
                submitBtn.disabled = false;
            }
        });
    })();
</script>
