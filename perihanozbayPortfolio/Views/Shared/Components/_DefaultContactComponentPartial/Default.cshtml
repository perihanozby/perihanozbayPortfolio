              >
                <form
                  class="flex flex-col gap-space-md"
                  id="contactForm"
                  onsubmit="
                    event.preventDefault();
                    handleFormSubmit();
                  "
                >
                  <div class="flex flex-col">
                    <h3
                      class="font-headline-md text-headline-sm md:text-headline-md text-primary font-bold"
                    >
                      Mesaj İletin
                    </h3>
                    <p class="font-body-sm text-body-sm text-outline">
                      Formu doldurarak doğrudan iletişime geçebilirsiniz. En geç
                      24 saat içinde dönüş sağlanır.
                    </p>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                    <!-- Ad Soyad (Zorunlu) -->
                    <div class="flex flex-col gap-1.5">
                      <label
                        class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                        for="FullName"
                      >
                        <span>Ad Soyad</span>
                        <span class="text-tertiary text-xs font-normal"
                          >* Zorunlu</span
                        >
                      </label>
                      <input
                        class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                        id="FullName"
                        name="FullName"
                        placeholder="Örn. Ahmet Yılmaz"
                        required=""
                        type="text"
                      />
                    </div>
                    <!-- E-posta (Geçerli format) -->
                    <div class="flex flex-col gap-1.5">
                      <label
                        class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                        for="Email"
                      >
                        <span>E-Posta Adresi</span>
                        <span class="text-tertiary text-xs font-normal"
                          >* Zorunlu</span
                        >
                      </label>
                      <input
                        class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                        id="Email"
                        name="Email"
                        placeholder="ornek@sirket.com"
                        required=""
                        type="email"
                      />
                    </div>
                  </div>
                  <!-- Konu -->
                  <div class="flex flex-col gap-1.5">
                    <label
                      class="font-label-md text-label-md text-primary font-semibold"
                      for="Subject"
                      >Konu Başlığı</label
