                      class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                      id="Subject"
                      name="Subject"
                    >
                      <option value="is-teklifi">
                        İş Fırsatı / Pozisyon Teklifi (.NET &amp; Backend)
                      </option>
                      <option value="proje-gelistirme">
                        Proje Geliştirme &amp; Mimari Danışmanlık
                      </option>
                      <option value="genel-soru">
                        Genel Bilgi &amp; Tanışma
                      </option>
                    </select>
                  </div>
                  <!-- Mesaj (Karakter Sayacı ile) -->
                  <div class="flex flex-col gap-1.5">
                    <div class="flex justify-between items-center">
                      <label
                        class="font-label-md text-label-md text-primary font-semibold"
                        for="Message"
                        >Mesajınız</label
                      >
                      <span
                        class="font-label-sm text-label-sm text-outline"
                        id="charCount"
                        >0 / 1000</span
                      >
                    </div>
                    <textarea
                      class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all resize-y"
                      id="Message"
                      maxlength="1000"
                      name="Message"
                      oninput="updateCharCount(this)"
                      placeholder="Projeniz, teklif detayları veya sormak istediğiniz soruları buraya yazabilirsiniz..."
                      required=""
                      rows="5"
                    ></textarea>
                  </div>
                  <!-- Submit Button (Terracotta Action) -->
                  <div
                    class="flex flex-col sm:flex-row items-center justify-between gap-space-sm pt-2"
