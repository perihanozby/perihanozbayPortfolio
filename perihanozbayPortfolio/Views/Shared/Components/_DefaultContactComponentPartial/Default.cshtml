                      <span
                        class="font-headline-sm text-label-lg text-primary font-semibold"
                        >perihan@ozbay.dev</span
                      >
                    </div>
                  </a>
                  <a
                    class="p-space-sm rounded-lg bg-surface-container-low hover:bg-secondary-container/40 transition-all flex items-center gap-space-sm group"
