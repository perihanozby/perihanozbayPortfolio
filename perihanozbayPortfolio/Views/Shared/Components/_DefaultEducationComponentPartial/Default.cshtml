
@model List<perihanozbayPortfolio.Entities.Education>

<div class="lg:col-span-6 flex flex-col">

    <div class="flex items-center gap-2 mb-space-md pb-2 border-b border-outline-variant/40">
        <span class="material-symbols-outlined text-primary-container text-[24px]">
            school
        </span>

        <h3 class="font-headline-md text-headline-sm text-primary font-semibold">
            Eğitim &amp; Akademik Geçmiş
        </h3>
    </div>

    <div class="relative pl-6 space-y-space-md before:content-[''] before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-secondary/40">

        @foreach (var education in Model)
        {
            <div class="relative">

                <span class="absolute -left-[27px] top-1.5 w-3 h-3 rounded-full @(education.IsCurrent ? "bg-surface-variant" : "bg-primary-container") ring-4 ring-background">
                </span>

                <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">

                    <div class="flex items-center justify-between mb-1">

                        <span class="font-headline-sm text-label-lg font-bold text-primary">
                            @education.Title
                        </span>

                        @if (!string.IsNullOrWhiteSpace(education.Badge))
                        {
                            <span class="px-2 py-0.5 rounded @(education.IsCurrent ? "bg-surface-container text-outline" : "bg-secondary-container text-primary") font-label-sm text-label-sm @(education.IsCurrent ? "" : "font-bold")">
                                @education.Badge
                            </span>
                        }
                        else if (!string.IsNullOrWhiteSpace(education.Period))
                        {
                            <span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-outline">
                                @education.Period
                            </span>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(education.Subtitle))
                    {
                        <p class="font-label-sm text-label-sm text-secondary font-semibold mb-2">
                            @education.Subtitle
                        </p>
                    }
                    else if (!string.IsNullOrWhiteSpace(education.Institution))
                    {
                        <p class="font-label-sm text-label-sm text-secondary font-semibold mb-2">
                            @education.Institution
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(education.Description))
                    {
                        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed @(education.Highlights.Any() ? "mb-2" : "")">
                            @education.Description
                        </p>
                    }

                    @if (education.Highlights.Any())
                    {
                        <div class="flex flex-wrap gap-1 mt-2">

                            @foreach (var highlight in education.Highlights)
                            {
                                <span class="px-2 py-0.5 bg-surface-container-high rounded text-xs">
                                    @highlight.Name
                                </span>
                            }

                        </div>
                    }

                </div>
            </div>
        }

    </div>
</div>
