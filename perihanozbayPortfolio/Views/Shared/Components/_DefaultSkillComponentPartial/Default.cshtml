
@model List<perihanozbayPortfolio.Entities.SkillCategory>

<section class="w-full py-space-xl bg-surface-container-low" id="yetenekler">
    <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-lg gap-space-sm">
            <div>
                <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
                    02 / Yetkinlik · Stack
                </span>

                <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary tracking-tight mt-1">
                    Teknik Yetenekler
                </h2>
            </div>

            <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">
                Pratik geliştirme süreçlerinde ve projelerde aktif kullanılan
                teknoloji derinliği ve hakimiyet göstergeleri.
            </p>
        </div>

        <!-- Skills Grid (Bento style) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">

            @foreach (var category in Model)
            {
                <div class="@(category.IsWide ? "md:col-span-2 lg:col-span-2" : "") bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between">

                    <div>
                        <div class="flex items-center justify-between mb-space-md">
                            <div class="flex items-center gap-2">

                                <span class="p-2 rounded bg-secondary-container text-primary material-symbols-outlined text-[20px]">
                                    @category.Icon
                                </span>

                                <h3 class="font-headline-sm text-headline-sm text-primary">
                                    @category.Name
                                </h3>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(category.Badge))
                            {
                                <span class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container @(category.DisplayOrder == 1 || category.IsWide ? "text-secondary" : "text-outline") font-bold">
                                    @category.Badge
                                </span>
                            }
                        </div>

                        <div class="@(category.IsWide ? "grid grid-cols-1 md:grid-cols-3 gap-space-md" : "space-y-3.5")">

                            @foreach (var skill in category.Skills)
                            {
                                <div>
                                    <div class="flex justify-between font-label-md text-label-md text-primary mb-1">
                                        <span>@skill.Name</span>

                                        <span class="font-bold text-secondary">
                                            @(skill.Percentage)%
                                        </span>
                                    </div>

                                    <div class="w-full h-2 rounded-full bg-surface-container overflow-hidden">
                                        <div
                                            class="h-full @category.ProgressBarColor rounded-full"
                                            style="width: @(skill.Percentage)%">
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(skill.Description))
                                    {
                                        <p class="font-body-sm text-body-sm text-outline mt-1.5">
                                            @skill.Description
                                        </p>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (category.SkillTags.Any())
                    {
                        <div class="mt-space-md pt-3 border-t border-surface-container text-xs text-on-surface-variant flex flex-wrap gap-1.5">

                            @foreach (var tag in category.SkillTags)
                            {
                                <span class="px-2 py-0.5 bg-surface-container rounded font-label-sm">
                                    @tag.Name
                                </span>
                            }

                        </div>
                    }
                </div>
            }

        </div>
    </div>
</section>
