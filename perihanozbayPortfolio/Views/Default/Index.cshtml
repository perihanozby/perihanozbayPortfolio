
@{
    ViewData["Title"] = "Perihan Özbay | Yazılım Mühendisi";
    Layout = "_Layout";
}

<div class="flex flex-col w-full">

    <!-- Top Ambient Highlight -->
    <div class="relative w-full overflow-hidden">

        <div class="absolute -top-32 -left-20 w-96 h-96 rounded-full bg-secondary-container/40 blur-3xl pointer-events-none"></div>

        <div class="absolute top-48 right-0 w-[28rem] h-[28rem] rounded-full bg-on-tertiary-container/10 blur-3xl pointer-events-none"></div>

        <!-- 1. HERO SECTION -->
        @await Component.InvokeAsync("_DefaultHeroComponentPartial")

    </div>

    <!-- METRIC STRIP -->
    @await Component.InvokeAsync("_DefaultMetricComponentPartial")

    <!-- 2. ABOUT ME (HAKKIMDA) SECTION -->
    @await Component.InvokeAsync("_DefaultAboutComponentPartial")

    <!-- 3. TECHNICAL SKILLS (YETENEKLER) -->
    @await Component.InvokeAsync("_DefaultSkillComponentPartial")

    <!-- 4. FEATURED PROJECTS (ÖNE ÇIKAN PROJELER) -->
    @await Component.InvokeAsync("_DefaultProjectComponentPartial")

    <!-- 5. PROFESSIONAL TIMELINE & EDUCATION -->
    <section class="w-full py-space-xl bg-surface-container-low"
             id="deneyim">

        <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">

            <div class="flex flex-col mb-space-lg">

                <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold">
                    04 / Kariyer · Süreç · Akademik Temel
                </span>

                <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary tracking-tight mt-1">
                    Deneyim &amp; Eğitim
                </h2>

            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl">

                <!-- Column 1: Experience -->
                @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

                <!-- Column 2: Education -->
                @await Component.InvokeAsync("_DefaultEducationComponentPartial")

            </div>

        </div>

    </section>

    <!-- 6. CONTACT -->
    @await Component.InvokeAsync("_DefaultContactComponentPartial")

</div>
