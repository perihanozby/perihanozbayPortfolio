  </head>
  <body
    class="bg-background font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-fixed"
  >
    <header
      class="fixed top-0 left-0 w-full z-50 bg-surface/85 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
    >
      <div
        class="h-20 max-w-[1240px] mx-auto px-margin-mobile md:px-margin flex items-center justify-between gap-gutter"
      >
        <div class="flex items-center gap-space-md shrink-0">
          <a
            class="flex items-center gap-space-sm group text-decoration-none"
            data-path="ana-sayfa"
            href="#"
            ><span
              class="w-9 h-9 rounded-lg bg-primary-container text-surface-container-lowest font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm transition-transform group-hover:scale-105"
              >PÖ</span
            >
            <div class="flex flex-col">
              <span
                class="font-headline-sm text-headline-sm text-primary tracking-tight leading-none"
                >perihan.özbay</span
              ><span
                class="font-label-sm text-label-sm text-secondary tracking-wider uppercase mt-0.5"
                >Yazılım Mühendisi</span
              >
            </div></a
          >
        </div>
       @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
        
      </div>
    </header>
    <main class="w-full pt-20 bg-background">
      <div class="flex flex-col w-full">
        <!-- Top Ambient Highlight -->
        <div class="relative w-full overflow-hidden">
          <div
            class="absolute -top-32 -left-20 w-96 h-96 rounded-full bg-secondary-container/40 blur-3xl pointer-events-none"
          ></div>
          <div
            class="absolute top-48 right-0 w-[28rem] h-[28rem] rounded-full bg-on-tertiary-container/10 blur-3xl pointer-events-none"
          ></div>
          <!-- 1. HERO SECTION -->
          <section
            class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin pt-space-lg md:pt-space-xl pb-space-xl w-full"
          >
            <div
              class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg lg:gap-gutter items-center"
            >
              <!-- Left: Editorial Content -->
              <div class="lg:col-span-7 flex flex-col items-start">
                <div
                  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-secondary-container/50 text-primary font-label-sm text-label-sm tracking-widest uppercase mb-space-md shadow-sm"
                >
                  <span
                    class="w-2 h-2 rounded-full bg-secondary animate-pulse"
                  ></span>
                  YAZILIM MÜHENDİSİ · .NET GELİŞTİRİCİ
                </div>
                <h1
                  class="font-display text-headline-lg md:text-display text-primary tracking-tight leading-none mb-space-sm"
                >
                  Merhaba, ben
                  <span
                    class="text-tertiary-container underline decoration-secondary-container decoration-4 underline-offset-8"
                    >Perihan</span
                  >.
                </h1>
                <p
                  class="font-headline-md text-headline-sm md:text-headline-md text-on-surface-variant font-medium leading-snug mb-space-md max-w-2xl"
                >
                  Fikirleri çalışan, dayanıklı ve ölçeklenen yazılımlara
                  dönüştürüyorum.
                </p>
                <p
                  class="font-body-lg text-body-md md:text-body-lg text-on-surface-variant/90 max-w-xl mb-space-lg leading-relaxed"
                >
                  Modern web uygulamaları, güçlü backend mimarileri ve
                  veritabanı odaklı çözümler geliştiriyorum. Teknolojiyi reel
                  kurumsal iş süreçleriyle, muhasebe akışlarıyla ve kullanıcı
                  deneyimiyle buluşturmayı önemsiyorum.
                </p>
                <!-- CTAs -->
                <div
                  class="flex flex-wrap items-center gap-space-sm md:gap-space-md w-full sm:w-auto mb-space-lg"
                >
                  <a
                    class="px-space-md py-3 rounded-lg bg-tertiary-container hover:bg-tertiary text-surface-container-lowest font-label-lg text-label-lg transition-all shadow-md hover:-translate-y-0.5 inline-flex items-center gap-2"
                    href="#projeler"
                  >
                    <span>Projelerimi İncele</span>
                    <span class="material-symbols-outlined text-[18px]"
                      >arrow_downward</span
                    >
                  </a>
                  <a
                    class="px-space-md py-3 rounded-lg bg-transparent hover:bg-primary-container text-primary-container hover:text-surface-container-lowest font-label-lg text-label-lg transition-all shadow-sm shadow-primary/5 inline-flex items-center gap-2"
                    href="#iletisim"
                  >
                    <span>Benimle İletişime Geç</span>
                    <span class="material-symbols-outlined text-[18px]"
                      >mail</span
                    >
                  </a>
                  <a
                    class="inline-flex items-center gap-1.5 px-3 py-3 text-primary-container font-label-md text-label-md hover:text-tertiary-container transition-colors underline decoration-outline-variant underline-offset-4"
                    href="#cv-indir"
                  >
                    <span class="material-symbols-outlined text-[20px]"
                      >download</span
                    >
                    <span>CV İndir</span>
                  </a>
                </div>
                <!-- Social Proof Badges & Icon Buttons -->
                <div
                  class="flex items-center gap-space-md pt-space-xs text-on-surface-variant"
                >
                  <span
                    class="font-label-sm text-label-sm uppercase tracking-wider text-outline"
                    >Bağlantılar</span
                  >
                  <div class="w-6 h-px bg-outline-variant"></div>
                  <div class="flex items-center gap-2">
                    <a
                      aria-label="GitHub Profilim"
                      class="w-10 h-10 rounded-lg bg-surface-container hover:bg-secondary-container text-primary flex items-center justify-center transition-all shadow-sm"
                      href="https://github.com"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >code</span
                      >
                    </a>
                    <a
                      aria-label="LinkedIn Profilim"
                      class="w-10 h-10 rounded-lg bg-surface-container hover:bg-secondary-container text-primary flex items-center justify-center transition-all shadow-sm"
                      href="https://linkedin.com"
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >badge</span
                      >
                    </a>
                    <a
                      aria-label="E-posta Gönder"
                      class="w-10 h-10 rounded-lg bg-surface-container hover:bg-secondary-container text-primary flex items-center justify-center transition-all shadow-sm"
                      href="mailto:perihan@ozbay.dev"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >alternate_email</span
                      >
                    </a>
                  </div>
                </div>
              </div>
              <!-- Right: Editorial Portrait & Technical Spec Card -->
              <div
                class="lg:col-span-5 relative mt-space-md lg:mt-0 flex justify-center"
              >
                <div class="relative w-full max-w-[420px]">
                  <!-- Architectural Background Plate -->
                  <div
                    class="absolute -inset-3 bg-secondary-container/60 rounded-xl transform -rotate-2"
                  ></div>
                  <div
                    class="relative bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden p-space-sm flex flex-col"
                  >
                    <div
                      class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high"
                    >
                      <img
                        class="w-full h-full object-cover object-center"
                        data-alt="Professional studio portrait of Perihan Özbay, a young female Turkish software engineer with warm soft lighting, minimalist cream and forest green studio aesthetic, wearing modern dark emerald blazer, intelligent calm expression, editorial quality"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuBauR8dL1t_-dHAiP5OcKpYwir9fTv9Mf57nygpUXtSRiSeCJsI3zkmkkym-KAOYncJCztZmXCOFEpfnOXn2Gh16uKyelLIm-e4oc1yCZYZqrJY0kY4rIq1GC8sL1uAup7v3YEFsDeq68jbV52q8r96CrCzDvggI6MyMM_p66k_ZGfMC57UxD9DbJcCSAnHKW77z0OBf_uvrRSXfluNT3yF2CVCrkPkRdQt90d5E10"
                      />
                      <div
                        class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"
                      ></div>
                      <!-- Bottom Badges inside Photo -->
                      <div
                        class="absolute bottom-4 left-4 right-4 flex flex-col gap-2"
                      >
                        <div
                          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-lowest/95 backdrop-blur text-primary shadow-sm font-label-sm text-label-sm w-fit"
                        >
                          <span
                            class="w-2 h-2 rounded-full bg-secondary-fixed-dim"
                          ></span>
                          <span>Malatya Turgut Özal Üniv. 2024 Mezunu</span>
                        </div>
                        <div
                          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-container text-surface-container-lowest shadow-sm font-label-sm text-label-sm w-fit"
                        >
                          <span
                            class="w-2 h-2 rounded-full bg-secondary-container animate-ping"
                          ></span>
                          <span
                            >Açık: Yeni İş Fırsatları (.NET &amp; Backend)</span
                          >
                        </div>
                      </div>
                    </div>
                    <!-- Metadata ticker -->
                    <div class="p-space-sm grid grid-cols-2 gap-2 text-left">
                      <div class="bg-surface-container-low p-2.5 rounded">
                        <p
                          class="font-label-sm text-label-sm text-outline uppercase tracking-wider"
                        >
                          Uzmanlık
                        </p>
                        <p
                          class="font-headline-sm text-label-lg text-primary font-semibold"
                        >
                          C# · ASP.NET Core
                        </p>
                      </div>
                      <div class="bg-surface-container-low p-2.5 rounded">
                        <p
                          class="font-label-sm text-label-sm text-outline uppercase tracking-wider"
                        >
                          Yaklaşım
                        </p>
                        <p
                          class="font-headline-sm text-label-lg text-primary font-semibold"
                        >
                          Clean Architecture
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
        <!-- METRIC STRIP -->
        <section
          class="w-full bg-surface-container-low py-space-md shadow-inner"
        >
          <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">
            <div
              class="grid grid-cols-2 md:grid-cols-4 gap-space-md text-center md:text-left"
            >
              <div class="flex flex-col">
                <span
                  class="font-display text-headline-lg text-primary-container"
                  >4+</span
                >
                <span
                  class="font-label-md text-label-md text-on-surface-variant"
                  >Yıllık Mühendislik Eğitimi &amp; Proje Pratiği</span
                >
              </div>
              <div class="flex flex-col">
                <span class="font-display text-headline-lg text-secondary"
                  >.NET 8</span
                >
                <span
                  class="font-label-md text-label-md text-on-surface-variant"
                  >Modern Web API ve MVC Standartları</span
                >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-display text-headline-lg text-tertiary-container"
                  >SQL</span
                >
                <span
                  class="font-label-md text-label-md text-on-surface-variant"
                  >İlişkisel Veritabanı ve Optimizasyon</span
                >
              </div>
              <div class="flex flex-col">
                <span class="font-display text-headline-lg text-primary"
                  >100%</span
                >
                <span
                  class="font-label-md text-label-md text-on-surface-variant"
                  >Temiz Kod ve Kurumsal Süreç Uyumu</span
                >
              </div>
            </div>
          </div>
        </section>
        <!-- 2. ABOUT ME (HAKKIMDA) SECTION -->
        <section class="w-full py-space-xl bg-background" id="hakkimda">
          <div class="max-w-[1240px] mx-auto px-margin-mobile md:px-margin">
            <div class="flex flex-col mb-space-lg">
              <span
                class="font-label-sm text-label-sm uppercase tracking-widest text-secondary font-bold"
                >01 / Profil · Mühendislik Yaklaşımı</span
              >
              <h2
                class="font-headline-lg text-headline-md md:text-headline-lg text-primary tracking-tight mt-1"
              >
                Hakkımda
              </h2>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
              <!-- Narrative Column -->
              <div
                class="lg:col-span-7 flex flex-col gap-space-md bg-surface-container-lowest p-space-lg rounded-xl shadow-sm"
              >
                <h3 class="font-headline-sm text-headline-sm text-primary">
                  Teknik sağlamlığı operasyonel gerçeklikle birleştiren
                  mühendislik bakışı.
                </h3>
                <p
                  class="font-body-md text-body-md text-on-surface leading-relaxed"
                >
                  Malatya Turgut Özal Üniversitesi Yazılım Mühendisliği
                  bölümünden 2024 yılında mezun oldum. Lisans sürecim boyunca
                  teorik algoritmik temellerin ötesine geçerek, özellikle
                  kurumsal ölçekte backend sistemleri, servis odaklı mimariler
                  ve veritabanı yönetimi alanında uzmanlaştım.
                </p>
                <p
                  class="font-body-md text-body-md text-on-surface leading-relaxed"
                >
                  Benim için bir yazılım geliştirmek yalnızca kod yazmaktan
                  ibaret değildir; bir muhasebe departmanının fatura
                  mutabakatını hızlandırmak, saha operasyonlarının veri girişini
                  kusursuz kılmak veya bir platformun veri bütünlüğünü garanti
                  altına almaktır. Gerçek iş süreçleri, muhasebe akışları ve
                  idari operasyonlarla iç içe çalışmış olmam, teknik
                  gereksinimleri iş mantığına dönüştürme yeteneğimi güçlendirdi.
                </p>
                <div
                  class="p-space-md bg-surface-container-low rounded-lg flex items-start gap-space-sm"
                >
                  <span
                    class="material-symbols-outlined text-secondary text-[24px] mt-0.5"
                    >verified</span
                  >
                  <p class="font-body-sm text-body-sm text-on-surface-variant">
                    <strong>Mühendislik İlkem:</strong> Sürdürülebilir mimari,
                    doğru veri modelleme ve bakımı kolay C# kod tabanı. Katmanlı
                    mimari (Clean/N-Tier) ve SOLID prensipleri üretim
                    standartlarımın temelidir.
                  </p>
                </div>
              </div>
              <!-- Information Matrix & Facts -->
              <div class="lg:col-span-5 flex flex-col gap-space-md">
                <div
                  class="bg-surface-container p-space-lg rounded-xl shadow-sm flex flex-col gap-space-md"
                >
                  <h4
                    class="font-label-lg text-label-lg uppercase tracking-wider text-primary font-bold"
                  >
                    Özet Bilgi Matrisi
                  </h4>
                  <div class="flex flex-col gap-space-sm">
                    <div
                      class="flex items-start justify-between py-2 border-b border-outline-variant/30"
                    >
                      <span class="font-label-md text-label-md text-outline"
                        >Eğitim</span
                      >
                      <span
                        class="font-body-sm text-body-sm text-primary font-semibold text-right"
                        >Yazılım Mühendisliği (Lisans, 2024)</span
                      >
                    </div>
                    <div
                      class="flex items-start justify-between py-2 border-b border-outline-variant/30"
                    >
                      <span class="font-label-md text-label-md text-outline"
                        >Üniversite</span
                      >
                      <span
                        class="font-body-sm text-body-sm text-primary font-semibold text-right"
                        >Malatya Turgut Özal Üniversitesi</span
                      >
                    </div>
                    <div
                      class="flex items-start justify-between py-2 border-b border-outline-variant/30"
                    >
                      <span class="font-label-md text-label-md text-outline"
                        >Ana Odak</span
                      >
                      <span
                        class="font-body-sm text-body-sm text-primary font-semibold text-right"
                        >.NET Core / Web API / Backend</span
                      >
                    </div>
                    <div
                      class="flex items-start justify-between py-2 border-b border-outline-variant/30"
                    >
                      <span class="font-label-md text-label-md text-outline"
                        >Konum</span
                      >
                      <span
                        class="font-body-sm text-body-sm text-primary font-semibold text-right"
                        >Türkiye (Hibrit · Uzaktan)</span
                      >
                    </div>
                    <div class="flex items-start justify-between py-2">
                      <span class="font-label-md text-label-md text-outline"
                        >Diller</span
                      >
