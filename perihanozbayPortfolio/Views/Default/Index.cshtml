                {
                  lineHeight: "48px",
                  letterSpacing: "-0.02em",
                  fontWeight: "600",
                },
              ],
              "label-sm": [
                "11px",
                {
                  lineHeight: "16px",
                  letterSpacing: "0.05em",
                  fontWeight: "700",
                },
              ],
              "body-lg": [
                "18px",
                {
                  lineHeight: "30px",
                  letterSpacing: "-0.01em",
                  fontWeight: "400",
                },
              ],
              display: [
                "56px",
                {
                  lineHeight: "64px",
                  letterSpacing: "-0.03em",
                  fontWeight: "700",
                },
