                        class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                        for="FullName"
                      >
                        <span>Ad Soyad</span>
                        <span class="text-tertiary text-xs font-normal"
                          >* Zorunlu</span
                        >
                      </label>
                      <input
                        class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                        id="FullName"
                        name="FullName"
                        placeholder="Örn. Ahmet Yılmaz"
                        required=""
                        type="text"
                      />
                    </div>
                    <!-- E-posta (Geçerli format) -->
                    <div class="flex flex-col gap-1.5">
                      <label
                        class="font-label-md text-label-md text-primary font-semibold flex items-center justify-between"
                        for="Email"
                      >
                        <span>E-Posta Adresi</span>
                        <span class="text-tertiary text-xs font-normal"
                          >* Zorunlu</span
                        >
                      </label>
                      <input
                        class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                        id="Email"
                        name="Email"
                        placeholder="ornek@sirket.com"
                        required=""
                        type="email"
                      />
                    </div>
                  </div>
                  <!-- Konu -->
                  <div class="flex flex-col gap-1.5">
                    <label
                      class="font-label-md text-label-md text-primary font-semibold"
                      for="Subject"
                      >Konu Başlığı</label
                    >
                    <select
                      class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all"
                      id="Subject"
                      name="Subject"
                    >
                      <option value="is-teklifi">
                        İş Fırsatı / Pozisyon Teklifi (.NET &amp; Backend)
                      </option>
                      <option value="proje-gelistirme">
                        Proje Geliştirme &amp; Mimari Danışmanlık
                      </option>
                      <option value="genel-soru">
                        Genel Bilgi &amp; Tanışma
                      </option>
                    </select>
                  </div>
                  <!-- Mesaj (Karakter Sayacı ile) -->
                  <div class="flex flex-col gap-1.5">
                    <div class="flex justify-between items-center">
                      <label
                        class="font-label-md text-label-md text-primary font-semibold"
                        for="Message"
                        >Mesajınız</label
                      >
                      <span
                        class="font-label-sm text-label-sm text-outline"
                        id="charCount"
                        >0 / 1000</span
                      >
                    </div>
                    <textarea
                      class="w-full px-3.5 py-2.5 rounded bg-surface-container-low text-on-surface placeholder:text-outline-variant font-body-sm text-body-sm outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container transition-all resize-y"
                      id="Message"
                      maxlength="1000"
                      name="Message"
                      oninput="updateCharCount(this)"
                      placeholder="Projeniz, teklif detayları veya sormak istediğiniz soruları buraya yazabilirsiniz..."
                      required=""
                      rows="5"
                    ></textarea>
                  </div>
                  <!-- Submit Button (Terracotta Action) -->
                  <div
                    class="flex flex-col sm:flex-row items-center justify-between gap-space-sm pt-2"
                  >
                    <button
                      class="w-full sm:w-auto px-space-lg py-3 rounded-lg bg-tertiary-container hover:bg-tertiary text-surface-container-lowest font-label-lg text-label-lg transition-all shadow-md hover:-translate-y-0.5 inline-flex items-center justify-center gap-2 cursor-pointer"
                      id="submitBtn"
                      type="submit"
                    >
                      <span>Mesaj Gönder</span>
                      <span class="material-symbols-outlined text-[18px]"
                        >send</span
                      >
                    </button>
                    <div class="flex items-center gap-2 text-xs text-outline">
                      <span
                        class="material-symbols-outlined text-[16px] text-secondary"
                        >database</span
                      >
                      <span>SQL Server güvenli veri kaydı garantisi</span>
                    </div>
                  </div>
                  <!-- Form Feedback Box (Hidden by default) -->
                  <div
                    class="hidden p-space-sm rounded-lg bg-secondary-container text-primary font-body-sm text-body-sm flex items-center gap-2"
                    id="formSuccessAlert"
                  >
                    <span
                      class="material-symbols-outlined text-secondary text-[22px]"
                      >check_circle</span
                    >
                    <span
                      >Mesajınız başarıyla iletildi. En kısa sürede sizinle
                      iletişime geçeceğim!</span
                    >
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>
        <!-- Interactive JavaScript Helper -->
        <script>
          function updateCharCount(textarea) {
            const currentLength = textarea.value.length;
            const counter = document.getElementById("charCount");
            if (counter) {
              counter.textContent = currentLength + " / 1000";
            }
          }

          function handleFormSubmit() {
            const btn = document.getElementById("submitBtn");
            const alert = document.getElementById("formSuccessAlert");
            const form = document.getElementById("contactForm");

            if (btn) {
              btn.disabled = true;
              btn.innerHTML =
                '<span>Gönderiliyor...</span><span class="material-symbols-outlined text-[18px] animate-spin">refresh</span>';
            }

            setTimeout(() => {
              if (alert) alert.classList.remove("hidden");
              if (btn) {
                btn.innerHTML =
                  '<span>İletildi</span><span class="material-symbols-outlined text-[18px]">done</span>';
                btn.classList.remove("bg-tertiary-container");
                btn.classList.add("bg-secondary");
              }
              if (form) form.reset();
              const counter = document.getElementById("charCount");
              if (counter) counter.textContent = "0 / 1000";
            }, 700);
          }
        </script>
      </div>
