              "surface-container-high": "#eae7e7",
              "inverse-surface": "#303030",
              "on-primary-container": "#87a599",
              "secondary-fixed": "#c5ecc9",
              "inverse-on-surface": "#f3f0f0",
              "on-primary-fixed": "#032018",
              "surface-container-low": "#f6f3f2",
              "surface-bright": "#fcf9f8",
              "tertiary-fixed-dim": "#ffb59b",
              "outline-variant": "#c1c8c4",
              "on-error": "#ffffff",
              "on-background": "#1b1c1c",
              "on-surface-variant": "#414845",
              "on-primary": "#ffffff",
              "on-tertiary-fixed": "#380d00",
              "surface-dim": "#dcd9d9",
              "on-error-container": "#93000a",
              surface: "#fcf9f8",
              secondary: "#44664b",
              "on-secondary": "#ffffff",
              "error-container": "#ffdad6",
              "on-secondary-container": "#4a6c50",
              "surface-container-highest": "#e4e2e1",
              background: "#fcf9f8",
              "surface-tint": "#48645a",
              "surface-variant": "#e4e2e1",
              tertiary: "#411000",
              "on-secondary-fixed": "#00210c",
              "on-secondary-fixed-variant": "#2c4e34",
              "primary-container": "#1f3b32",
              "secondary-fixed-dim": "#aad0ae",
              "on-tertiary-fixed-variant": "#773116",
              "tertiary-container": "#612106",
              outline: "#727975",
              error: "#ba1a1a",
              "primary-fixed": "#caeadc",
              "on-tertiary": "#ffffff",
              "inverse-primary": "#aecdc1",
              "on-surface": "#1b1c1c",
              "tertiary-fixed": "#ffdbcf",
              "on-primary-fixed-variant": "#304c43",
              "surface-container": "#f0eded",
